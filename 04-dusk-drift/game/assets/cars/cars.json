 "_common": {
  "convention": "glTF +Y 向上，车头 +Z，左侧 +X；原点在地面、前后轴中点、左右居中；顶层 5 个节点 body / wheel_FL / wheel_FR / wheel_RL / wheel_RR，均无旋转无缩放",
  "wheelNode": "wheel_XX 原点在轮心、轮轴沿局部 X；子节点 wheel_XX_spin 是会转的部分（轮胎/轮辋/刹车盘），wheel_XX_fixed 是卡钳/轮毂（转向时跟着转、不自转）。只想简单处理时直接转 wheel_XX 整体也可以。wheel_XX_spin 节点可能带外倾角旋转：自转要绕它自身的 X 轴",
  "materials": "所有材质 doubleSided=true（沿用原模型设置，Capri 的 GLASS 除外）；没有导出切线；贴图为 JPEG（带透明的为 PNG）",
  "units": "米"
 },
